{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zuno",
  "version": "1.1.0",
  "identifier": "com.zuno.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Zuno",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "mini-player",
        "url": "/mini.html",
        "width": 146,
        "height": 116,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "visible": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyMDQ0MjEzQjkxMThGQ0MKUldUTWp4RzVFMElFTXZGMmxnOC84VXlUTkZyaStyQzFkcXd6UVczeGNBNkVuWWU3MjdIM2JLVkgK",
      "endpoints": [
        "https://github.com/noFAYZ/zuno/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/noFAYZ/zuno/updater-channel/latest.json"
      ]
    }
  }
}
